<Project>
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>
    <PackageOutputPath>$(MSBuildThisFileDirectory)publish/packages</PackageOutputPath>
    <Authors>ape-byte</Authors>
    <Company>ape-byte</Company>
    <PackageProjectUrl>https://github.com/ape-byte/crules</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ape-byte/crules</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>csharp;rules;expressions;dynamicexpresso</PackageTags>
    <PackageReleaseNotes>Add netstandard2.0, net6.0 and net8.0 assets alongside net10.0 in one package. See the framework compatibility and NativeAOT documentation for validation scope and requirements.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets/nuget/$(MSBuildProjectName).md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)assets/branding/crules-icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
