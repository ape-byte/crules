<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../NuGet.props" />

  <ItemGroup>
    <ProjectReference Include="..\CRules.Abstractions\CRules.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.6" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>CRules</PackageId>
    <Description>A lightweight C#-style rule executor built on DynamicExpresso public APIs. Supports typed and named inputs, expression-tree execution, dictionaries and asynchronous results. NativeAOT requires the documented interpreted profile.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
