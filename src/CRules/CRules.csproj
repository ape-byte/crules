<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../NuGet.props" />

  <ItemGroup>
    <ProjectReference Include="..\CRules.Abstractions\CRules.Abstractions.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.6" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework />
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>CRules</PackageId>
    <Description>A lightweight C#-style rule executor built on DynamicExpresso public APIs. Supports typed and named inputs, expression-tree execution, dictionaries and asynchronous results. NativeAOT requires the documented interpreted profile.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Include="../Compatibility.cs" Link="Compatibility.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeAbstractionsAssembly</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeAbstractionsAssembly" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_AbstractionsAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'CRules.Abstractions' And '%(Extension)' == '.dll'" />
      <BuildOutputInPackage Include="@(_AbstractionsAssembly)" />
      <BuildOutputInPackage Include="@(_AbstractionsAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
      <BuildOutputInPackage Include="@(_AbstractionsAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
  </Target>

</Project>
