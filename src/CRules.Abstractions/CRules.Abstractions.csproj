<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../NuGet.props" />

  <PropertyGroup>
    <TargetFramework />
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <PackageId>CRules.Abstractions</PackageId>
    <Description>Public execution contracts, diagnostics and the optional typed JSON DataObject for CRules. This package does not depend on DynamicExpresso.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>
